# Copy to .env and fill in. Never commit .env or rsa_key.p8.

# From your URL app.snowflake.com/szgyyax/mq45252 -> org-account
SNOWFLAKE_ACCOUNT=szgyyax-mq45252
SNOWFLAKE_USER=RISHABH
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=AGENT_WH
SNOWFLAKE_PRIVATE_KEY_FILE=rsa_key.p8

# Semantic layer the agents query (built by semantic_layer.sql)
AGENT_DATABASE=AGENT_DB
AGENT_SCHEMA=ANALYTICS
SEMANTIC_VIEW=AGENT_DB.ANALYTICS.SALES_SV

# LLM provider:
#   google    -> free key from https://aistudio.google.com/apikey
#   anthropic -> needs ANTHROPIC_API_KEY
#   cortex    -> runs inside Snowflake, but NOT available on trial accounts
LLM_PROVIDER=google
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-flash-latest
# CORTEX_MODEL=claude-3-5-sonnet
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: see every agent step in LangSmith (free tier is fine)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=snowflake-agents
